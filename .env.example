# Documentation only: Relayloom does not load .env files automatically.
# Keep the default rehearsal command until live inference is explicitly approved.
# Never commit real keys or a populated copy of this file.
MODEL_API_KEY=
RELAYLOOM_META_ENDPOINT=https://api.meta.ai/v1/chat/completions
RELAYLOOM_META_MODEL=muse-spark-1.3
RELAYLOOM_SYNTHETIC_ONLY=I_CONFIRM_SYNTHETIC_DATA
# Set a real absolute path to an ignored local SQLite file, separate from workroom DB.
RELAYLOOM_META_LEDGER=
RELAYLOOM_META_MAX_ATTEMPTS=6
