# The workroom (python -m relayloom) does not load .env. The accounts payable app (python -m relayloom.ap) reads .env.
# Keep the default rehearsal command until live inference is explicitly approved.
# Never commit real keys or a populated copy of this file.
MODEL_API_KEY=
RELAYLOOM_META_ENDPOINT=https://api.meta.ai/v1/chat/completions
RELAYLOOM_META_MODEL=muse-spark-1.3
RELAYLOOM_SYNTHETIC_ONLY=I_CONFIRM_SYNTHETIC_DATA
# Set a real absolute path to an ignored local SQLite file, separate from workroom DB.
RELAYLOOM_META_LEDGER=
RELAYLOOM_META_MAX_ATTEMPTS=6

# Accounts payable (python -m relayloom.ap). .env is read by the app; keep real values only there.
# Paid Meta Model API above stays OFF in this build: everything below runs on Meta open weights.
HF_TOKEN=
GLIMMER_URL=http://127.0.0.1:8082/v1
RELAYLOOM_SAM_PYTHON=D:/relayloom-models/venv-sam/Scripts/python.exe
RELAYLOOM_SAM_WEIGHTS=
ERPNEXT_URL=http://localhost:8080
ERPNEXT_COMPANY=Northgate Components (synthetic)
ERPNEXT_TAX_ACCOUNT=Input GST - NGC
ERPNEXT_ADMIN_PASSWORD=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# Optional, only if a free key works without a card. Off when empty.
GROQ_API_KEY=
